	(text "USART2 (PA2/PA3, DE PA1): column bus master -> CPD-1, CBP-8 x 2, TCD-1.  USART1 (PA9/PA10, DE PA12): tower bus slave."
		(at 14 281.732 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "f040c6dc-1ca7-5a5b-8b2a-ae507273d6fd")
	)
	(text "I2C1 PA15/PB7: SHT45 (0x44).  I2C3 PC8/PC9: SDP810-500Pa (0x25).  Both 100 kHz, 2.2k pull-ups, TPD4E05 ESD."
		(at 14 286.732 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "c6364a95-ebf9-5f5a-ab3d-dd2d6bff7982")
	)
	(text "Timers: flow 1 PA5 (TIM2_CH1), flow 2 PB6 (TIM4_CH1), pump tach PC6 (TIM3_CH1), impeller 3 tach PC7 (TIM3_CH2);"
		(at 14 291.732 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "4d682e0f-b953-5bfc-946f-b84457526ce3")
	)
	(text "pump PWM PA8 (TIM1_CH1, 25 kHz, open drain inverted); light bar PB4 (TIM3_CH1 alt / DMA bit-bang)."
		(at 14 296.732 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "105e2744-c73a-5865-8298-83961ed742fa")
	)
	(text "DAC1_OUT1 PA4 -> LM321 x 3 -> chiller set point 0-9.9 V.  ADC: NTC1-6 PC0 PC1 PC2 PC3 PA6 PA7, leak PB0 PB1, 12V_IN PB2."
		(at 14 301.732 0)
		(effects
			(font
