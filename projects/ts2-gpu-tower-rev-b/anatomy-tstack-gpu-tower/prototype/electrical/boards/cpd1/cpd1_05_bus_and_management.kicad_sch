	(text "Bus and management"
		(at 13.5 22.5 0)
		(effects
			(font
				(size 2 2)
				bold
			)
			(justify left bottom)
		)
		(uuid "cb7991be-cffc-59f1-b9a9-3797dcaa1906")
	)
	(text "+12V / RTN: 3 + 3 planes of 4 oz.  Per PSU 166 A over ~25 mm of 3 x 4 oz, ~40 mm wide: ~26 uOhm, ~0.7 W per pole at full load."
		(at 14 345.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8fd6d3d0-77d3-5c3b-a6c6-5b6b69da9e4b")
	)
	(text "Studs: 8 x M6 per pole, PEM FHS-M6 class; straps TS2B-232 / TS2B-233 (C11000 12 x 6 mm, tin plated, upturned 2-hole M8 lug legs at both ends) 6 N m."
		(at 14 350.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d8e96ef8-2184-586f-9b5d-fd2aac1e6d35")
	)
	(text "VSB_BUS (12 V standby): always-on 3.3 V buck for the MCU, and a 2.5 A PTC feed to the CCM-1 (SYS connector J7 pins 1/2)."
		(at 14 355.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "e556df08-b23b-5193-a2c3-6a857fc7bebb")
	)
	(text "MCU: I2C1-4 = PSU 1-4 PMBus; USART2 PA2 TX / PA3 RX / PA1 DE (RS-485); ADC PA0 ISHARE, PA4 +12V bus, PA5 VSB_BUS,"
		(at 14 360.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d4a05664-c479-5ff1-8e67-c2f1775b1aa8")
	)
	(text "PC0/PC1 NTC (strap + inlet air); PB5 PSON_REQ# in; PB4 COL_PWR_OK out; ADDR PB6/PB9; LEDs PC13 OK, PF1 fault."
		(at 14 365.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "153d2057-1d8c-5310-b565-1f18cd6cfc45")
	)
	(text "Policy (firmware): PSUs stay off until CCM-1 pulls PSON_REQ# low (cooling ready).  Then PS_ON for all present PSUs with"
		(at 14 370.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "ea1ca88b-4e90-5d82-8e22-47b95d77d486")
	)
	(text "AC_OK; COL_PWR_OK when >= 3 report PW_OK.  A PSU with an ALERT is polled (STATUS_WORD) and reported over Modbus."
		(at 14 375.16 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "bd61a660-44a8-5fbd-ad07-81ec7288f400")
	)
)
