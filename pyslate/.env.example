# Copy to .env on the server and fill in. Never commit the real .env.
PYSLATE_PUBLIC_URL=https://pyslate.com
# Password for /admin. Use a long random value.
PYSLATE_ADMIN_TOKEN=
# Signs admin sessions. Use a long random value, e.g. `openssl rand -hex 32`.
PYSLATE_SECRET_KEY=
POSTGRES_PASSWORD=
# Optional. Without these, orders wait for you to mark them paid in the admin console.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PYSLATE_MAX_UPLOAD_MB=50
